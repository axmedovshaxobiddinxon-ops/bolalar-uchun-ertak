# ============================================================
# Bolalar Uchun Ertak — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Text AI Provider ──────────────────────────────────────
TEXT_AI_PROVIDER=openai
TEXT_AI_MODEL=gpt-4o
OPENAI_API_KEY=sk-...your-key-here...

# ── Image AI Provider (Phase 3) ───────────────────────────
# Set to "openai" to enable AI image generation.
# Leave blank to keep the feature disabled.
IMAGE_AI_PROVIDER=openai

# Model choices:
#   gpt-image-1   → latest (recommended, supports transparent background)
#   dall-e-3      → previous generation (supports vivid/natural style)
IMAGE_AI_MODEL=gpt-image-1

# Image size: 1024x1024 (square, default) | 1792x1024 | 1024x1792
IMAGE_AI_SIZE=1024x1024

# Quality:
#   gpt-image-1:  low | medium (default) | high | auto
#   dall-e-3:     standard | hd
IMAGE_AI_QUALITY=medium

# Style (dall-e-3 only): vivid | natural
IMAGE_AI_STYLE=vivid

# Background (gpt-image-1 only): opaque (default) | transparent | auto
IMAGE_AI_BACKGROUND=opaque

# Concurrent image requests (default: 2). Increase carefully to avoid rate limits.
IMAGE_AI_CONCURRENCY=2

# ── Video AI Provider (Phase 4 — leave blank for now) ─────
VIDEO_AI_PROVIDER=
VIDEO_AI_MODEL=runway-gen3

# ── Rate Limiting ─────────────────────────────────────────
# Requests per minute per IP (default: 10)
RATE_LIMIT_GENERATE=10
